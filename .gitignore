# 密钥永不入库
.env

# Generated provider responses can contain expiring signed media URLs.
projects/**/shots/*result*.json
projects/**/shots/*status*.json

# 重媒体产物不进 git;留痕(film.json/md/prompt)进。
# 2026-07-24 用户拍板扩订:锚点/hero 图(png/jpg)与 woff2 字体也不进 git——
# 均可再生(锚点按 film.json.gen 的 prompt 重出、字体按 review.md 记的命令重子集化),
# 只保留文本 IR/配方层,进一步瘦身仓库。成片与媒体走 CDN + 本地归档(~/kuleshov-archive)。
projects/**/*.mp4
projects/**/*.mov
projects/**/*.wav
projects/**/*.mp3
projects/**/*.png
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.woff2
node_modules/
.DS_Store

# 工作残渣不进 git（2026-07-21 清库新规）：抢救转储 / 原始 API 报文（gen 留痕在 film.json）
projects/**/recovered/
projects/**/anchors/*_response.json
projects/**/audio/payload*.json
projects/**/audio/response*.json
projects/**/audio/mm_*.json

# compose 中间产物(可由脚本复现)
projects/**/compose/bake_frames/
projects/**/compose/snapshots/
projects/**/compose/snap3d/
projects/**/compose/snapv2/
projects/**/shots/frames*/
projects/**/review_frames/
projects/**/compose/.hyperframes/
projects/**/shots/*-res.json

# film-ir（Python 包）
film-ir/.venv/
film-ir/**/__pycache__/
film-ir/**/*.egg-info/
film-ir/.pytest_cache/

# Film IR 锁文件
projects/**/film.json.lock

# out/ 里的重复副本不进 git（真身在项目根与 evidence/）；out/ 只留 COSTS.md 与 RUNLOG.md 这类独有内容
projects/**/out/film.json
projects/**/out/review.md
projects/**/out/render-metrics.json
# 失败版重建脚手架与其分析：一次性中间产物，结论已并进 review.md 与 ledger
projects/**/out/v1-failed/
projects/**/compose-v1/
# forced-align 的中间输入（由 audio/narration.txt 一行重生成）
projects/**/audio/spoken.json
